<Window x:Class="PluginShelf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PluginShelf" Width="1260" Height="800" MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="{StaticResource InkBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"
        FontFamily="Segoe UI" Foreground="{StaticResource TextPrimaryBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="LtrPathTextStyle" TargetType="TextBlock">
            <Setter Property="FlowDirection" Value="LeftToRight" />
            <Setter Property="TextAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="Consolas, Segoe UI" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </Window.Resources>

    <Grid x:Name="RootLayout" Background="{StaticResource InkBrush}">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="RootScaleTransform" ScaleX="1.0" ScaleY="1.0" />
        </Grid.LayoutTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="68" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0E1524" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,0,1" Padding="22,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="12" Background="#1C3344" BorderBrush="#2C5963" BorderThickness="1">
                        <TextBlock Text="PS" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,12,0" VerticalAlignment="Center">
                        <TextBlock x:Name="AppNameText" Text="Plugin Shelf" FontSize="17" FontWeight="Bold" />
                        <TextBlock x:Name="AppTaglineText" Text="A safer, clearer plug-in library" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="TopStatusText" Grid.Column="1" Text="Preview first · nothing moves until you approve" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="12,0" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#15253A" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="10" Padding="10,6" Margin="0,0,8,0">
                        <TextBlock x:Name="SafeModeText" Text="SAFE MODE" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
                    </Border>
                    <Border Background="#121A2B" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="9" Padding="4,2" Margin="0,0,8,0" FlowDirection="LeftToRight">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="ZoomOutButton" Content="−" Style="{StaticResource SecondaryButton}" Padding="8,3" BorderThickness="0" FontSize="12" Click="ZoomOutButton_Click" ToolTip="Ctrl+-" />
                            <Button x:Name="ZoomResetButton" Content="100%" Style="{StaticResource SecondaryButton}" Padding="8,3" BorderThickness="0" FontSize="11" Click="ZoomResetButton_Click" ToolTip="Ctrl+0" />
                            <Button x:Name="ZoomInButton" Content="+" Style="{StaticResource SecondaryButton}" Padding="8,3" BorderThickness="0" FontSize="12" Click="ZoomInButton_Click" ToolTip="Ctrl++" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="LanguageButton" Content="عربي | EN" Style="{StaticResource SecondaryButton}" Padding="12,7" Click="LanguageButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#0E1524" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="14,20,14,16">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock x:Name="WorkspaceLabel" Text="WORKSPACE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="12,2,12,10" />
                        <Button x:Name="OverviewNav" Tag="Overview" Content="⌂    Overview" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left" Margin="0,2" Click="NavigationButton_Click" />
                        <Button x:Name="ReviewNav" Tag="Review" Content="◉    Review variants" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left" Margin="0,2" Click="NavigationButton_Click" />
                        <Button x:Name="QuarantineNav" Tag="Quarantine" Content="↺    Quarantine" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left" Margin="0,2" Click="NavigationButton_Click" />
                        <Button x:Name="SettingsNav" Tag="Settings" Content="⚙    Settings" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left" Margin="0,2" Click="NavigationButton_Click" />
                    </StackPanel>
                    <Border DockPanel.Dock="Bottom" Background="#121A2B" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="12" Padding="13" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock x:Name="PriorityTitleText" Text="Recommendation order" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="12" />
                            <TextBlock x:Name="PriorityHintText" Text="1) x64 first (x86 only if absent)&#x0a;2) VST3 → VST/DLL → CLAP&#x0a;3) Newest readable release in tier&#x0a;4) Ties/ambiguous → manual review" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" FontSize="11" LineHeight="16" Margin="0,6,0,0" />
                            <Border Background="#172338" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="8,6" Margin="0,9,0,0">
                                <TextBlock x:Name="WavesHintText" Text="Waves / WaveShell / WPAPI excluded · No file dates used" TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}" FontSize="10" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                    </Border>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1" Margin="26,20,26,20">
                <!-- OVERVIEW -->
                <Grid x:Name="OverviewPage" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="160" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,14">
                        <TextBlock x:Name="OverviewTitle" Text="Your plug-in library, under control" FontSize="25" FontWeight="Bold" />
                        <TextBlock x:Name="OverviewSubtitle" Text="Find format duplicates, review every proposed change, and restore anything from quarantine." Foreground="{StaticResource TextMutedBrush}" FontSize="13" Margin="0,5,0,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="20" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock x:Name="ScanCardTitle" Text="Start with a read-only scan" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock x:Name="ScanCardDescription" Text="The scan reads plug-in metadata only. It never loads plug-in code and never moves files." Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,5,0,0" />
                                <TextBlock x:Name="ScanStatusText" Text="Ready when you are." Foreground="{StaticResource AccentBrush}" FontSize="11" Margin="0,9,0,0" TextWrapping="Wrap" />
                                <ProgressBar x:Name="ScanProgressBar" Height="5" Minimum="0" Maximum="100" Value="0" Margin="0,9,0,0" Background="#1B2940" Foreground="{StaticResource AccentBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <Button x:Name="ScanButton" Content="Scan folders" Style="{StaticResource PrimaryButton}" MinWidth="148" Click="ScanButton_Click" />
                                <Button x:Name="CancelScanButton" Content="Cancel scan" Style="{StaticResource SecondaryButton}" Margin="0,8,0,0" IsEnabled="False" Click="CancelScanButton_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,14">
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,6,0" Padding="15,13">
                            <StackPanel><TextBlock x:Name="PathsMetricLabel" Text="SCAN FOLDERS" FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontWeight="Bold" /><TextBlock x:Name="PathsMetric" Text="11" FontSize="23" FontWeight="Bold" Margin="0,4,0,0" /><TextBlock x:Name="PathsMetricHint" Text="configured" FontSize="10" Foreground="{StaticResource TextMutedBrush}" /></StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}" Margin="6,0" Padding="15,13">
                            <StackPanel><TextBlock x:Name="CandidatesMetricLabel" Text="CANDIDATES" FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontWeight="Bold" /><TextBlock x:Name="CandidatesMetric" Text="—" FontSize="23" FontWeight="Bold" Margin="0,4,0,0" /><TextBlock x:Name="CandidatesMetricHint" Text="recognized items" FontSize="10" Foreground="{StaticResource TextMutedBrush}" /></StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}" Margin="6,0" Padding="15,13">
                            <StackPanel><TextBlock x:Name="GroupsMetricLabel" Text="DUPLICATE GROUPS" FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontWeight="Bold" /><TextBlock x:Name="GroupsMetric" Text="—" FontSize="23" FontWeight="Bold" Margin="0,4,0,0" /><TextBlock x:Name="GroupsMetricHint" Text="need a review" FontSize="10" Foreground="{StaticResource TextMutedBrush}" /></StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}" Margin="6,0,0,0" Padding="15,13">
                            <StackPanel><TextBlock x:Name="QuarantineMetricLabel" Text="QUARANTINED" FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontWeight="Bold" /><TextBlock x:Name="QuarantineMetric" Text="0" FontSize="23" FontWeight="Bold" Margin="0,4,0,0" /><TextBlock x:Name="QuarantineMetricHint" Text="restorable items" FontSize="10" Foreground="{StaticResource TextMutedBrush}" /></StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                <Button x:Name="OpenReviewButton" Content="Open review" Style="{StaticResource SecondaryButton}" DockPanel.Dock="Right" Click="OpenReviewButton_Click" />
                                <StackPanel>
                                    <TextBlock x:Name="RecentGroupsTitle" Text="Review queue" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock x:Name="RecentGroupsSubtitle" Text="Only confirmed plug-in variants can enter a quarantine plan." Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                            <DataGrid x:Name="OverviewGroupsGrid" Grid.Row="1" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow" CanUserSortColumns="False" MouseDoubleClick="OverviewGroupsGrid_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn x:Name="OverviewNameColumn" Header="Plug-in" Binding="{Binding DisplayName}" Width="1.8*" />
                                    <DataGridTextColumn x:Name="OverviewVendorColumn" Header="Vendor" Binding="{Binding Vendor}" Width="1*" />
                                    <DataGridTextColumn x:Name="OverviewCountColumn" Header="Variants" Binding="{Binding CandidateCountLabel}" Width="0.8*" />
                                    <DataGridTextColumn x:Name="OverviewMatchColumn" Header="Match" Binding="{Binding MatchSummary}" Width="2.4*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- REVIEW -->
                <Grid x:Name="ReviewPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                            <Button x:Name="SelectRecommendedButton" Content="Select strong recommendations" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="SelectRecommendedButton_Click" />
                            <Button x:Name="ClearSelectionButton" Content="Clear selection" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="ClearSelectionButton_Click" />
                            <Button x:Name="ToggleIncludedButton" Content="Show included groups" Style="{StaticResource SecondaryButton}" Visibility="Collapsed" Click="ToggleIncludedButton_Click" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock x:Name="ReviewTitle" Text="Review format variants" FontSize="24" FontWeight="Bold" />
                            <TextBlock x:Name="ReviewSubtitle" Text="The suggested keeper is only a recommendation. Nothing changes until you apply." Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>

                    <Border Grid.Row="1" Background="#101829" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="260" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ReviewRulesBannerText" Grid.Column="0" Text="Strict rules: x64 first → VST3 &gt; VST/DLL &gt; CLAP → newest version in tier. Generations (Pro-Q 3 vs 4) and I/O (Mono/Stereo/SC) stay separate. Ties &amp; aliases require manual review." Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,14,0" />
                            <TextBox x:Name="ReviewSearchBox" Grid.Column="1" VerticalContentAlignment="Center" TextChanged="ReviewSearchBox_TextChanged" ToolTip="Filter by plug-in or vendor name" />
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="GroupsPanel" />
                    </ScrollViewer>

                    <Border Grid.Row="3" Background="#0E1524" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="14" Padding="14,12" Margin="0,12,0,0">
                        <DockPanel>
                            <Button x:Name="ApplyButton" Content="Move selected variants to quarantine" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right" Margin="14,0,0,0" IsEnabled="False" Click="ApplyButton_Click" />
                            <TextBlock x:Name="ReviewFooterText" Text="Review each group. Ambiguous aliases stay untouched until confirmed." Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- QUARANTINE -->
                <Grid x:Name="QuarantinePage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,14">
                        <Button x:Name="RefreshQuarantineButton" Content="Refresh" Style="{StaticResource SecondaryButton}" DockPanel.Dock="Right" VerticalAlignment="Top" Click="RefreshQuarantineButton_Click" />
                        <StackPanel>
                            <TextBlock x:Name="QuarantineTitle" Text="Recoverable quarantine" FontSize="24" FontWeight="Bold" />
                            <TextBlock x:Name="QuarantineSubtitle" Text="Items are moved, never permanently deleted. Restore will not overwrite an existing original path." Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                    <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="12">
                        <DataGrid x:Name="QuarantineGrid" SelectionMode="Extended" SelectionUnit="FullRow" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn x:Name="QNameColumn" Header="Plug-in" Binding="{Binding PluginName}" Width="1.3*" />
                                <DataGridTextColumn x:Name="QFormatColumn" Header="Format" Binding="{Binding Format}" Width="0.9*" />
                                <DataGridTextColumn x:Name="QArchColumn" Header="Architecture" Binding="{Binding Architecture}" Width="1*" />
                                <DataGridTextColumn x:Name="QMovedColumn" Header="Moved" Binding="{Binding MovedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="1.1*" />
                                <DataGridTextColumn x:Name="QPathColumn" Header="Original path" Binding="{Binding OriginalPath}" ElementStyle="{StaticResource LtrPathTextStyle}" Width="2.8*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <DockPanel Grid.Row="2" Margin="0,12,0,0">
                        <Button x:Name="RestoreButton" Content="Restore selected" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right" Margin="14,0,0,0" IsEnabled="False" Click="RestoreButton_Click" />
                        <TextBlock x:Name="QuarantineFooterText" Text="Select one or more entries to restore." Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>
                </Grid>

                <!-- SETTINGS -->
                <Grid x:Name="SettingsPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,14">
                        <TextBlock x:Name="SettingsTitle" Text="Scan settings" FontSize="24" FontWeight="Bold" />
                        <TextBlock x:Name="SettingsSubtitle" Text="Add or remove scan folders. VST, VST3 and CLAP are recognized in this release." Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="12">
                        <DataGrid x:Name="RootsGrid" SelectionMode="Single" SelectionUnit="FullRow">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn x:Name="RootEnabledColumn" Header="On" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="64" />
                                <DataGridTextColumn x:Name="RootPathColumn" Header="Folder path" Binding="{Binding Path, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource LtrPathTextStyle}" Width="3*" />
                                <DataGridTextColumn x:Name="RootKindColumn" Header="Known format scope" Binding="{Binding KindLabel}" IsReadOnly="True" Width="1.2*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <DockPanel Grid.Row="2" Margin="0,12,0,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="14,0,0,0">
                            <Button x:Name="ResetDefaultsButton" Content="Reset defaults" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="ResetDefaultsButton_Click" />
                            <Button x:Name="AddFolderButton" Content="Add folder" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="AddFolderButton_Click" />
                            <Button x:Name="RemoveFolderButton" Content="Remove selected" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="RemoveFolderButton_Click" />
                            <Button x:Name="SaveSettingsButton" Content="Save settings" Style="{StaticResource PrimaryButton}" Click="SaveSettingsButton_Click" />
                        </StackPanel>
                        <TextBlock x:Name="SettingsSafetyText" Text="WPAPI and all Waves-related paths/items are excluded. Custom folders use known formats only." Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
